# Anthropic API Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Port Configuration (optional - defaults shown)
VNC_PORT=5900
STREAMLIT_PORT=8501
NOVNC_PORT=6080
HTTP_PORT=8080

# Per-role model overrides (all optional - see browser_use_demo/model_config.py)
# Coordinator's default model. Empty/unset = first entry in streamlit.py's
# BROWSER_COMPATIBLE_MODELS list. Still changeable per-session in the sidebar.
# BROWSER_USE_MAIN_MODEL=

# Model for the `find` browser action's semantic element matching (a separate,
# direct API call). Defaults to a fast/cheap model since it's a narrow task.
# BROWSER_USE_FIND_MODEL=claude-haiku-4-5-20251001

# Model for each dispatch_subagents worker. Empty/unset = inherit the
# coordinator's own model.
# BROWSER_USE_SUBAGENT_MODEL=

# Model for verify_finding's independent verification session. Empty/unset =
# inherit the coordinator's own model.
# BROWSER_USE_VERIFY_MODEL=